app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Data of the old app (third-party databases, shop owners' phone numbers): never in git
/old app/
*.xapk
*.apk
*.aab

# Server runtime data
server/*.db
server/*.sqlite*
server/__pycache__/
__pycache__/

# Local tool settings
/.claude/
